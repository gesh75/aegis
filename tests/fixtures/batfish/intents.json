{
  "intents": [
    {"id": "guest-cannot-reach-cde", "kind": "reachability",
     "start": "@enter(r1[GigabitEthernet0/1])", "src_ips": "10.50.1.10",
     "dst_ips": "10.10.0.0/24", "protocols": ["tcp"], "dst_ports": "22",
     "expect": "deny", "control": "PCI DSS v4.0 1.3.1",
     "description": "Guest VLAN must never reach the cardholder data environment"},
    {"id": "guest-can-reach-web", "kind": "reachability",
     "start": "@enter(r1[GigabitEthernet0/1])", "src_ips": "10.50.1.10",
     "dst_ips": "10.20.0.10", "protocols": ["tcp"], "dst_ports": "443",
     "expect": "allow"},
    {"id": "no-undefined-references", "kind": "undefined_references", "expect": "none"},
    {"id": "no-shadowed-acl-lines", "kind": "filter_line_reachability", "expect": "none"}
  ]
}
